{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "suspicious": {
        "noConsole": "error"
      },
      "style": {
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "fetch": "HTTP в web минава през apiFetch от src/api/client.ts (docs/architecture.md)."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/logger.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/api/client.ts",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "src/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    }
  ]
}
