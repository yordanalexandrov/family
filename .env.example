# Копирай във `.env` (игнориран от git). Compose и api четат оттук.
# На homesrv `.env` го пише .github/workflows/deploy.yml от secrets на GitHub Environment production; нова
# променлива за продукцията = secret в Environment-а + ред в стъпката "Write runtime env" (infra/README.md → GitHub).

# Postgres: `docker compose up -d postgres`. Същата парола влиза и в DATABASE_URL.
# docker-compose.yml я слага сам в DATABASE_URL на api контейнера, затова без символи, които URL иска escape-нати (напр. `openssl rand -hex 24`).
POSTGRES_PASSWORD=

# api → Postgres (127.0.0.1:5432, виж docker-compose.yml). Замени <pw> с POSTGRES_PASSWORD.
DATABASE_URL=postgres://family:<pw>@127.0.0.1:5432/family

# Тестова база за `pnpm test`: `docker compose --profile test up -d postgres-test` (tmpfs, фиксирана парола).
DATABASE_URL_TEST=postgres://family:test@127.0.0.1:5433/family

# Как api удостоверява заявките към /api/* (/healthz е извън проверката):
#   dev        — локално: токен не се проверява, всяка заявка идва от DEV_USER_EMAIL;
#   cloudflare — продукция: валидира Cloudflare Access JWT от хедъра Cf-Access-Jwt-Assertion.
# При NODE_ENV=production api отказва да стартира с друго освен cloudflare.
# docker-compose.yml пуска api контейнера винаги с cloudflare; локален стек с dev: docker-compose.override.yml.example (infra/README.md).
AUTH_MODE=dev

# Само при AUTH_MODE=dev: имейлът, от чието име идва всяка заявка (/api/me го връща като accessEmail).
DEV_USER_EMAIL=parent@example.com

# Само при AUTH_MODE=cloudflare (задължителни):
# Team domain на Zero Trust, https://<team>.cloudflareaccess.com. Това е издателят (iss) на токена; ключовете се теглят от <team domain>/cdn-cgi/access/certs.
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) Tag на Access приложението: Zero Trust → Access controls → Applications → приложението → Configure → Additional settings.
CF_ACCESS_AUD=
# Имейлите, които api пуска, разделени със запетая (главни/малки букви без значение). Втора проверка зад политиката на Access.
ALLOWED_EMAILS=

# OpenClaw gateway за AI контрактите (ADR-0004, docs/research/openclaw-invocation.md). api вика POST <OPENCLAW_URL>/v1/chat/completions.
# На homesrv gateway-ът слуша само на 127.0.0.1:18789; локално: ssh тунел (README → Smoke тест на recipe.suggest).
OPENCLAW_URL=http://127.0.0.1:18789
# gateway.auth.password: пълен operator достъп, никога в логове или в репото. Задължителен, освен при AUTH_MODE=dev.
# Празен в AUTH_MODE=dev = предложенията са изключени: POST /api/recipe-suggestions/requests връща 503 openclaw_unavailable.
OPENCLAW_GATEWAY_PASSWORD=
# Агентът на recipe.suggest (prompt-ът му: docs/openclaw/family-recipe.md).
OPENCLAW_RECIPE_AGENT=family-recipe
# Таймаут в ms на цялото извикване: един общ бюджет и за повторния опит при невалиден изход.
OPENCLAW_TIMEOUT_MS=180000

# Часова зона на backup (dump в 03:00 по нея) и на api в docker-compose.yml.
TZ=Europe/Sofia
